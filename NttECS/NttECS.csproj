<Project Sdk="Microsoft.NET.Sdk">

  <PropertyGroup>
    <TargetFramework>net9.0</TargetFramework>
    <ImplicitUsings>enable</ImplicitUsings>
    <Nullable>enable</Nullable>
    <AllowUnsafeBlocks>true</AllowUnsafeBlocks>
    <LangVersion>latest</LangVersion>
    <WarningLevel>4</WarningLevel>
    
    <!-- Library package information -->
    <PackageId>NttECS</PackageId>
    <Version>1.0.0</Version>
    <Authors>MagnumOpus Team</Authors>
    <Description>High-performance Entity Component System library with threading support</Description>
    <PackageTags>ECS;Entity;Component;System;Game;Performance</PackageTags>
  </PropertyGroup>

  <ItemGroup>
    <PackageReference Include="prometheus-net" Version="8.*" />
  </ItemGroup>

</Project>
